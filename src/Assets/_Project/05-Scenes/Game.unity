  text: 
  ru: "\u0421\u043E\u0431\u0435\u0440\u0438 \u0432 \u0440\u044F\u0434: \u0411\u0443\u043B\u043A\u0430
    \u2192 \u041A\u043E\u0442\u043B\u0435\u0442\u0430 \u2192 \u0411\u0443\u043B\u043A\u0430.
